{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "User profile and workspace RBAC binding matching web /users/{uid}",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "ownerUid": { "type": "string", "description": "Absent or null for workspace owner; owner UID for team members" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "roles": { "type": "array", "description": "Granted role keys: admin, rep, production, factory, payments, sales" },
        "approved": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "inviteId": { "type": "string" },
        "authProviders": { "type": "array" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "lastWrite": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "WorkspaceInvite": {
      "title": "WorkspaceInvite",
      "description": "Invitation for Google Sign-In team member onboarding",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "ownerName": { "type": "string" },
        "memberEmail": { "type": "string" },
        "displayName": { "type": "string" },
        "roles": { "type": "array" },
        "approved": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "accepted", "revoked"] },
        "acceptedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "ownerName", "memberEmail", "displayName", "roles", "approved", "status", "createdAt", "updatedAt"]
    },
    "ProductionRecord": {
      "title": "ProductionRecord",
      "description": "Store production weight log, rep return-to-store card, or stock transfer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "store": { "type": "string" },
        "grossWt": { "type": "number" },
        "contWt": { "type": "number" },
        "net": { "type": "number" },
        "cp": { "type": "number" },
        "sp": { "type": "number" },
        "totalCost": { "type": "number" },
        "totalSale": { "type": "number" },
        "profit": { "type": "number" },
        "formulaUnits": { "type": "number" },
        "formulaId": { "type": "string" },
        "formulaName": { "type": "string" },
        "formulaMaterials": { "type": "array" },
        "formulaCost": { "type": "number" },
        "isReturn": { "type": "boolean" },
        "returnedBy": { "type": "string" },
        "returnNote": { "type": "string" },
        "isTransfer": { "type": "boolean" },
        "transferDirection": { "type": "string", "enum": ["out", "in"] },
        "transferPairId": { "type": "string" },
        "transferPeerStore": { "type": "string" },
        "transferNote": { "type": "string" },
        "isMerged": { "type": "boolean" },
        "photoKeys": { "type": "array" },
        "timestamp": { "type": "integer" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "SalesOrRepRecord": {
      "title": "SalesOrRepRecord",
      "description": "Direct sales (sales) or field rep sales/returns (rep) matching web schema",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "supplyDate": { "type": "string" },
        "time": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "quantity": { "type": "number" },
        "supplyStore": { "type": "string" },
        "paymentType": { "type": "string", "enum": ["CASH", "CREDIT", "COLLECTION", "PARTIAL_PAYMENT", "MONEY_OUT", "REP_RETURN"] },
        "salesRep": { "type": "string" },
        "currentRepProfile": { "type": "string" },
        "unitPrice": { "type": "number" },
        "totalValue": { "type": "number" },
        "totalCost": { "type": "number" },
        "profit": { "type": "number" },
        "costSource": { "type": "string" },
        "creditReceived": { "type": "boolean" },
        "partialPaymentReceived": { "type": "number" },
        "collectionAllocs": { "type": "object" },
        "isCollection": { "type": "boolean" },
        "collectedAmount": { "type": "number" },
        "allocations": { "type": "object" },
        "expiredQty": { "type": "number" },
        "expiredValue": { "type": "number" },
        "expiredUnitPrice": { "type": "number" },
        "expiredApplied": { "type": "number" },
        "expiredAllocated": { "type": "number" },
        "transactionType": { "type": "string" },
        "isRepTransfer": { "type": "boolean" },
        "repTransferFrom": { "type": "string" },
        "isTransfer": { "type": "boolean" },
        "transferFrom": { "type": "string" },
        "transferPairId": { "type": "string" },
        "relatedSaleId": { "type": "string" },
        "affectsInventory": { "type": "boolean" },
        "usedInCalcId": { "type": "string" },
        "isRepReturn": { "type": "boolean" },
        "returnedQty": { "type": "number" },
        "returnValue": { "type": "number" },
        "gps": { "type": "object" },
        "isMerged": { "type": "boolean" }
      }
    },
    "CustomerOrClient": {
      "title": "CustomerOrClient",
      "description": "Direct sales customer (customers) or field rep client (clients)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "oldDebit": { "type": "number" },
        "customSalePrice": { "type": "number" },
        "salesRep": { "type": "string" },
        "gps": { "type": "object" },
        "visitCount": { "type": "integer" },
        "notes": { "type": "string" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      }
    },
    "CalculatorRecord": {
      "title": "CalculatorRecord",
      "description": "Rep settlement calculation matching web calculator collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "seller": { "type": "string" },
        "date": { "type": "string" },
        "unitPrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "revenue": { "type": "number" },
        "profit": { "type": "number" },
        "totalCost": { "type": "number" },
        "totalSold": { "type": "number" },
        "returned": { "type": "number" },
        "returnStore": { "type": "string" },
        "returnEntryId": { "type": "string" },
        "returnLogId": { "type": "string" },
        "expiredApplied": { "type": "number" },
        "returnRep": { "type": "string" },
        "returnType": { "type": "string" },
        "transferSaleId": { "type": "string" },
        "expired": { "type": "number" },
        "shared": { "type": "number" },
        "creditQty": { "type": "number" },
        "cashQty": { "type": "number" },
        "creditValue": { "type": "number" },
        "prevColl": { "type": "number" },
        "fieldExpenses": { "type": "number" },
        "fieldExpenseItems": { "type": "array" },
        "commissionPaidItems": { "type": "array" },
        "totalExpected": { "type": "number" },
        "received": { "type": "number" },
        "commissionPerUnit": { "type": "number" },
        "commissionPaid": { "type": "number" },
        "grossCommission": { "type": "number" },
        "commissionPayable": { "type": "number" },
        "linkedSalesIds": { "type": "array" },
        "linkedRepSalesIds": { "type": "array" },
        "linkedRepReturnIds": { "type": "array" }
      }
    },
    "InventoryRecord": {
      "title": "InventoryRecord",
      "description": "Raw material master item or purchase lot (isPurchaseLot=true)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "cost": { "type": "number" },
        "totalValue": { "type": "number" },
        "collectedKg": { "type": "number" },
        "conversionFactor": { "type": "number" },
        "purchaseUnitName": { "type": "string" },
        "purchaseCost": { "type": "number" },
        "purchaseQuantity": { "type": "number" },
        "purchasesTracked": { "type": "boolean" },
        "isPurchaseLot": { "type": "boolean" },
        "materialRefId": { "type": "string" },
        "materialName": { "type": "string" },
        "purchaseKg": { "type": "number" },
        "purchaseDate": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid"] },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "supplierContact": { "type": "string" },
        "supplierType": { "type": "string" },
        "totalPayable": { "type": "number" },
        "paidDate": { "type": "string" }
      }
    },
    "FactoryRecord": {
      "title": "FactoryRecord",
      "description": "Factory batch unit production record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "store": { "type": "string" },
        "formulaId": { "type": "string" },
        "formulaName": { "type": "string" },
        "units": { "type": "number" },
        "totalCost": { "type": "number" },
        "materialsCost": { "type": "number" },
        "additionalCost": { "type": "number" },
        "rawMaterialsUsed": { "type": "array" },
        "materialsUsed": { "type": "array" },
        "notes": { "type": "string" }
      }
    },
    "EntityRecord": {
      "title": "EntityRecord",
      "description": "Supplier, employee, partner, or expense entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "contact": { "type": "string" },
        "phone": { "type": "string" },
        "isSupplier": { "type": "boolean" },
        "isExpenseEntity": { "type": "boolean" },
        "openingBalance": { "type": "number" },
        "notes": { "type": "string" }
      }
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Payments ledger transaction (IN, OUT, payable credit, or entity transfer)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "entityId": { "type": "string" },
        "entityName": { "type": "string" },
        "entityType": { "type": "string" },
        "type": { "type": "string", "enum": ["IN", "OUT"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "isPayable": { "type": "boolean" },
        "isTransfer": { "type": "boolean" },
        "transferPairId": { "type": "string" },
        "transferDirection": { "type": "string" },
        "peerEntityName": { "type": "string" },
        "isOpeningBalance": { "type": "boolean" },
        "isMerged": { "type": "boolean" }
      }
    },
    "ExpenseRecord": {
      "title": "ExpenseRecord",
      "description": "Operating expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "notes": { "type": "string" },
        "entityId": { "type": "string" },
        "entityName": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "isMerged": { "type": "boolean" }
      }
    },
    "ReturnRecord": {
      "title": "ReturnRecord",
      "description": "Stock return or recovered CHORA log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "store": { "type": "string" },
        "returnStore": { "type": "string" },
        "seller": { "type": "string" },
        "customerName": { "type": "string" },
        "quantity": { "type": "number" },
        "expiredQty": { "type": "number" },
        "recoveredQty": { "type": "number" },
        "recovered": { "type": "boolean" },
        "recoveredDate": { "type": "string" },
        "returnType": { "type": "string" },
        "notes": { "type": "string" },
        "isMerged": { "type": "boolean" }
      }
    },
    "DeletionTombstone": {
      "title": "DeletionTombstone",
      "description": "Soft-delete tombstone with 90-day snapshot for Recycle Bin restore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recordId": { "type": "string" },
        "collection": { "type": "string" },
        "recordType": { "type": "string" },
        "deletedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "displayName": { "type": "string" },
        "displayDetail": { "type": "string" },
        "displayAmount": { "type": "string" },
        "snapshot": { "type": "object" },
        "deleted_by": { "type": "string" }
      }
    },
    "PhotoDocument": {
      "title": "PhotoDocument",
      "description": "Entity/customer/expense photo blob document keyed by URL-safe base64",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "data": { "type": "string" },
        "deleted": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["key", "updatedAt"]
    },
    "PendingApproval": {
      "title": "PendingApproval",
      "description": "Non-admin member action queued for admin approval matching web pending collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "collection": { "type": "string" },
        "docId": { "type": "string" },
        "action": { "type": "string", "enum": ["set", "delete"] },
        "data": { "type": "object" },
        "isEdit": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "submittedBy": { "type": "object" },
        "submittedAt": { "type": "integer" },
        "summary": { "type": "object" },
        "decidedBy": { "type": "object" },
        "decidedAt": { "type": "integer" }
      },
      "required": ["id", "collection", "docId", "action", "status", "submittedBy", "submittedAt"]
    },
    "FcmToken": {
      "title": "FcmToken",
      "description": "Admin push notification token scoped to uid_deviceId",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "token": { "type": "string" },
        "platform": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "token", "platform", "updatedAt"]
    },
    "WorkspaceSingletonConfig": {
      "title": "WorkspaceSingletonConfig",
      "description": "Singleton config document (settings/config, stores/list, formulas/config, daily_ledger/entries, categories/list, etc.)",
      "type": "object"
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "UserAccount", "description": "User account and workspace role binding" },
    "/workspace_invites/{inviteId}": { "schema": "WorkspaceInvite", "description": "Workspace team member invites" },
    "/users/{ownerId}/production/{recordId}": { "schema": "ProductionRecord", "description": "Production logs, returns, and transfers" },
    "/users/{ownerId}/sales/{recordId}": { "schema": "SalesOrRepRecord", "description": "Direct sales and collections" },
    "/users/{ownerId}/rep/{recordId}": { "schema": "SalesOrRepRecord", "description": "Field rep sales, collections, and returns" },
    "/users/{ownerId}/clients/{clientId}": { "schema": "CustomerOrClient", "description": "Field rep customer directory" },
    "/users/{ownerId}/customers/{customerId}": { "schema": "CustomerOrClient", "description": "Direct sales customer directory" },
    "/users/{ownerId}/calculator/{recordId}": { "schema": "CalculatorRecord", "description": "Rep calculator settlements" },
    "/users/{ownerId}/inventory/{itemId}": { "schema": "InventoryRecord", "description": "Raw materials and purchase lots" },
    "/users/{ownerId}/factory/{recordId}": { "schema": "FactoryRecord", "description": "Factory batch unit production" },
    "/users/{ownerId}/entities/{entityId}": { "schema": "EntityRecord", "description": "Suppliers, staff, partners, expense entities" },
    "/users/{ownerId}/transactions/{recordId}": { "schema": "PaymentTransaction", "description": "Payments IN/OUT and entity transfers" },
    "/users/{ownerId}/expenses/{recordId}": { "schema": "ExpenseRecord", "description": "Operating expenses" },
    "/users/{ownerId}/returns/{recordId}": { "schema": "ReturnRecord", "description": "Stock returns and CHORA logs" },
    "/users/{ownerId}/deletions/{recordId}": { "schema": "DeletionTombstone", "description": "90-day soft deletion tombstones" },
    "/users/{ownerId}/photos/{photoId}": { "schema": "PhotoDocument", "description": "Synced entity/customer/expense photos" },
    "/users/{ownerId}/pending/{pendingId}": { "schema": "PendingApproval", "description": "Non-admin submissions awaiting approval" },
    "/users/{ownerId}/fcm_tokens/{tokenId}": { "schema": "FcmToken", "description": "Admin push notification device tokens" },
    "/users/{ownerId}/settings/{docId}": { "schema": "WorkspaceSingletonConfig", "description": "settings/config, settings/team, settings/accounts, settings/yearCloseSignal" },
    "/users/{ownerId}/formulas/{docId}": { "schema": "WorkspaceSingletonConfig", "description": "formulas/config singleton" },
    "/users/{ownerId}/stores/{docId}": { "schema": "WorkspaceSingletonConfig", "description": "stores/list singleton" },
    "/users/{ownerId}/categories/{docId}": { "schema": "WorkspaceSingletonConfig", "description": "categories/list singleton" },
    "/users/{ownerId}/daily_ledger/{docId}": { "schema": "WorkspaceSingletonConfig", "description": "daily_ledger/entries singleton" },
    "/users/{ownerId}/field_expense_categories/{docId}": { "schema": "WorkspaceSingletonConfig", "description": "field_expense_categories/list singleton" },
    "/users/{ownerId}/commission_categories/{docId}": { "schema": "WorkspaceSingletonConfig", "description": "commission_categories/list singleton" },
    "/users/{ownerId}/account/{docId}": { "schema": "WorkspaceSingletonConfig", "description": "account/info singleton" },
    "/users/{ownerId}/devices/{docId}": { "schema": "WorkspaceSingletonConfig", "description": "Synced device registry" }
  }
}
