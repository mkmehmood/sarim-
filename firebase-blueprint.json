  "firestore": {
    "/users/{userId}": { "schema": "UserProfile", "description": "User profile and workspace binding" },
    "/workspace_invites/{inviteId}": { "schema": "WorkspaceInvite", "description": "Workspace member invitations" },
    "/users/{ownerId}/stores/{storeId}": { "schema": "StoreConfig", "description": "Store configurations" },
    "/users/{ownerId}/formulas/{formulaId}": { "schema": "FormulaConfig", "description": "Formula recipes and presets" },
    "/users/{ownerId}/customers/{customerId}": { "schema": "CustomerRecord", "description": "Customer directory" },
    "/users/{ownerId}/entities/{entityId}": { "schema": "EntityRecord", "description": "Suppliers, parties, staff, and expense accounts" },
    "/users/{ownerId}/inventory/{itemId}": { "schema": "InventoryItem", "description": "Raw material inventory items" },
    "/users/{ownerId}/production/{recordId}": { "schema": "ProductionRecord", "description": "Production logs and stock transfers" },
    "/users/{ownerId}/sales/{recordId}": { "schema": "SalesRecord", "description": "Sales and collections" },
    "/users/{ownerId}/rep_records/{recordId}": { "schema": "RepRecord", "description": "Field rep sales, collections, and returns" },
    "/users/{ownerId}/calculator/{recordId}": { "schema": "CalculatorSettlement", "description": "Rep settlement records" },
    "/users/{ownerId}/factory/{recordId}": { "schema": "FactoryRecord", "description": "Factory batches and raw material purchases" },
    "/users/{ownerId}/transactions/{recordId}": { "schema": "PaymentTransaction", "description": "Payment IN/OUT/transfers" },
    "/users/{ownerId}/ledger_entries/{recordId}": { "schema": "DailyLedgerEntry", "description": "Daily ledger cashbook entries" },
    "/users/{ownerId}/pending/{pendingId}": { "schema": "PendingApproval", "description": "Non-admin team submissions pending approval" },
    "/users/{ownerId}/settings/{settingId}": { "schema": "WorkspaceSettings", "description": "Workspace settings document" }
  }
