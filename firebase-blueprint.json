{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and workspace role assignment",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "Verified Google email" },
        "displayName": { "type": "string", "description": "Display name" },
        "workspaceOwnerUid": { "type": "string", "description": "Owner UID of active workspace" },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "roles": { "type": "array", "description": "Granted feature role keys" },
        "approved": { "type": "boolean" },
        "inviteId": { "type": "string", "description": "Optional invite ID used to join workspace" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["uid", "email", "displayName", "workspaceOwnerUid", "role", "roles", "approved", "createdAt", "updatedAt"]
    },
    "WorkspaceInvite": {
      "title": "WorkspaceInvite",
      "description": "Workspace collaboration invite created by an admin",
