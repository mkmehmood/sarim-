rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Identity, Workspace & RBAC Helpers
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-:.=]+$');
    }

    function meRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function getUserData() {
      return get(meRef()).data;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Active = has a user doc, is not suspended (approved != false), and email matches when present.
    function notSuspended() {
      return signedIn() && exists(meRef())
        && getUserData().get('approved', true) != false
        && (request.auth.token.email == null
            || getUserData().get('email', request.auth.token.email).lower()
               == request.auth.token.email.lower());
    }

    function dataIsAdmin(data) {
      return 'admin' in data.get('roles', []) || data.get('role', 'user') == 'admin';
    }

    function isAdmin() {
      return notSuspended() && dataIsAdmin(getUserData());
    }

    // Workspace = owner's UID. Owners have ownerUid absent/null; members point at ownerUid.
    function wsOwner() {
      return (getUserData().get('ownerUid', null) is string && getUserData().get('ownerUid', '') != '')
        ? getUserData().ownerUid
        : request.auth.uid;
    }

    function inWorkspace(owner) {
      return notSuspended() && wsOwner() == owner;
    }

    function managedByMe(data, uid) {
      return data.get('ownerUid', null) == wsOwner()
        || (data.get('ownerUid', null) == null
            && data.get('createdBy', '') == request.auth.token.email)
        || uid == wsOwner();
    }

    function targetUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isValidInvite(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 120
        && data.memberEmail is string && data.memberEmail.size() >= 3 && data.memberEmail.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.roles is list && data.roles.size() <= 10
        && data.approved is bool
        && data.status in ['pending', 'accepted', 'revoked']
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 3. Root User & Invite Documents

    match /users/{uid} {
      allow list: if signedIn() && (
        request.auth.uid == uid
        || inWorkspace(uid)
        || (isAdmin() && managedByMe(existing(), uid))
      );

      allow get: if isValidId(uid) && signedIn() && (
        isOwner(uid)
        || inWorkspace(uid)
        || (isAdmin() && managedByMe(existing(), uid))
      );

      allow create: if isValidId(uid) && signedIn() && (
        // Case A: First-time workspace owner self-bootstrap (Google Sign-In new user)
        (
          isOwner(uid)
          && !exists(meRef())
          && incoming().get('ownerUid', null) == null
          && dataIsAdmin(incoming())
          && incoming().get('approved', true) == true
          && incoming().keys().hasOnly([
            'uid', 'email', 'displayName', 'role', 'roles', 'approved',
            'ownerUid', 'authProviders', 'lastLoginAt', 'lastWrite', 'createdAt', 'updatedAt'
          ])
          && (!('uid' in incoming()) || incoming().uid == uid)
        ) ||
        // Case B: Verified team member joining via workspace invite
        (
          isOwner(uid)
          && !exists(meRef())
          && 'inviteId' in incoming()
          && isValidId(incoming().inviteId)
          && exists(/databases/$(database)/documents/workspace_invites/$(incoming().inviteId))
          && get(/databases/$(database)/documents/workspace_invites/$(incoming().inviteId)).data.ownerUid == incoming().ownerUid
          && get(/databases/$(database)/documents/workspace_invites/$(incoming().inviteId)).data.status == 'pending'
          && get(/databases/$(database)/documents/workspace_invites/$(incoming().inviteId)).data.approved == true
          && request.auth.token.email_verified == true
          && get(/databases/$(database)/documents/workspace_invites/$(incoming().inviteId)).data.memberEmail == request.auth.token.email.lower()
          && !dataIsAdmin(incoming())
          && incoming().get('role', 'user') != 'admin'
        ) ||
        // Case C: Existing workspace admin creating a member document (web parity)
        (
          isAdmin()
          && incoming().get('ownerUid', null) == wsOwner()
        )
      );

      allow update: if isValidId(uid) && signedIn() && (
        // Admin managing someone else in their workspace (never the workspace owner)
        (
          isAdmin() && uid != request.auth.uid && uid != wsOwner()
          && managedByMe(existing(), uid)
          && (incoming().get('ownerUid', null) == wsOwner()
              || incoming().get('ownerUid', null) == existing().get('ownerUid', null))
        ) ||
        // Admin editing themselves may not drop admin status or switch workspace owner
        (
          isAdmin() && isOwner(uid) && dataIsAdmin(incoming())
          && incoming().get('ownerUid', null) == existing().get('ownerUid', null)
        ) ||
        // Owners may update harmless profile/sync fields on their own doc
        (
          isOwner(uid) && notSuspended()
          && incoming().diff(existing()).affectedKeys()
               .hasOnly(['lastWrite', 'lastLoginAt', 'authProviders', 'displayName', 'updatedAt'])
        ) ||
        // Members ping the workspace owner's doc so every device re-syncs
        (
          inWorkspace(uid) && !isOwner(uid)
          && incoming().diff(existing()).affectedKeys().hasOnly(['lastWrite'])
        )
      );

      allow delete: if isValidId(uid) && isAdmin()
        && uid != request.auth.uid && uid != wsOwner()
        && managedByMe(existing(), uid);
    }

    match /workspace_invites/{inviteId} {
      allow list: if signedIn() && (
        existing().ownerUid == request.auth.uid ||
        (request.auth.token.email_verified == true && existing().memberEmail == request.auth.token.email.lower())
      );
      allow get: if isValidId(inviteId) && signedIn() && (
        existing().ownerUid == request.auth.uid ||
        (request.auth.token.email_verified == true && existing().memberEmail == request.auth.token.email.lower())
      );
      allow create: if isValidId(inviteId) && isAdmin()
        && incoming().ownerUid == wsOwner()
        && isValidInvite(incoming())
        && incoming().keys().hasAll(['ownerUid', 'ownerName', 'memberEmail', 'displayName', 'roles', 'approved', 'status', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['ownerUid', 'ownerName', 'memberEmail', 'displayName', 'roles', 'approved', 'status', 'acceptedByUid', 'createdAt', 'updatedAt']);
      allow update: if isValidId(inviteId) && signedIn()
        && isValidInvite(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && (
          (
            isAdmin() && existing().ownerUid == wsOwner()
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'roles', 'approved', 'status', 'updatedAt'])
          ) ||
          (
            existing().status == 'pending'
            && request.auth.token.email_verified == true
            && existing().memberEmail == request.auth.token.email.lower()
            && incoming().status == 'accepted'
            && incoming().acceptedByUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'updatedAt'])
          )
        );
      allow delete: if isValidId(inviteId) && isAdmin() && existing().ownerUid == wsOwner();
    }

    // 4. Pending Approvals (Non-admin team submissions)

    function validPending(pid) {
      let d = incoming();
      return d.status == 'pending'
        && d.id == pid
        && d.submittedBy is map
        && d.submittedBy.uid == request.auth.uid
        && d.action in ['set', 'delete']
        && d.collection in [
          'production', 'sales', 'rep', 'clients', 'customers', 'calculator',
          'inventory', 'factory', 'entities', 'transactions', 'expenses', 'returns'
        ];
    }

    match /users/{uid}/pending/{pid} {
      allow list: if isValidId(uid) && inWorkspace(uid)
        && (isAdmin() || existing().submittedBy.uid == request.auth.uid);
      allow get: if isValidId(uid) && isValidId(pid) && inWorkspace(uid)
        && (isAdmin() || existing().submittedBy.uid == request.auth.uid);
      allow create: if isValidId(uid) && isValidId(pid) && inWorkspace(uid)
        && (isAdmin() || validPending(pid));
      allow update: if isValidId(uid) && isValidId(pid) && inWorkspace(uid)
        && (isAdmin()
            || (validPending(pid)
                && (existing().status != 'pending'
                    || existing().submittedBy.uid == request.auth.uid)));
      allow delete: if isValidId(uid) && isValidId(pid) && inWorkspace(uid)
        && (isAdmin() || existing().submittedBy.uid == request.auth.uid);
    }

    // 5. Push Device Tokens (Admin self-managed only)

    match /users/{uid}/fcm_tokens/{tokenId} {
      allow list: if isValidId(uid) && inWorkspace(uid) && isAdmin()
        && existing().uid == request.auth.uid;
      allow get, delete: if isValidId(uid) && isValidId(tokenId)
        && inWorkspace(uid) && isAdmin()
        && existing().uid == request.auth.uid;
      allow create, update: if isValidId(uid) && isValidId(tokenId)
        && inWorkspace(uid) && isAdmin()
        && incoming().uid == request.auth.uid
        && tokenId.matches(request.auth.uid + '_.*')
        && incoming().keys().hasOnly(['uid', 'token', 'platform', 'updatedAt'])
        && incoming().token is string
        && incoming().token.size() < 400;
    }

    // 6. Synced Photos (All workspace members read/write photo payloads & deletion tombstones; admin only hard-delete)

    function isValidPhotoDoc(data) {
      return data.keys().hasAll(['key', 'updatedAt'])
        && data.keys().hasOnly(['key', 'data', 'deleted', 'updatedAt'])
        && data.key is string && data.key.size() >= 1 && data.key.size() <= 240
        && (!('data' in data) || data.data == null || (data.data is string && data.data.size() <= 900000))
        && (!('deleted' in data) || data.deleted is bool);
    }

    match /users/{uid}/photos/{photoId} {
      allow list: if isValidId(uid) && inWorkspace(uid);
      allow get: if isValidId(uid) && isValidId(photoId) && inWorkspace(uid);
      allow create, update: if isValidId(uid) && isValidId(photoId) && inWorkspace(uid) && isValidPhotoDoc(incoming());
      allow delete: if isValidId(uid) && isValidId(photoId) && inWorkspace(uid) && isAdmin();
    }

    // 7. Workspace Sync Collections & Singletons (Web Parity RBAC)

    function allowedWorkspaceSub(subcollection) {
      return subcollection in [
        'production', 'sales', 'rep', 'clients', 'customers', 'calculator',
        'inventory', 'factory', 'entities', 'transactions', 'expenses', 'returns',
        'deletions', 'settings', 'formulas', 'stores', 'categories', 'daily_ledger',
        'field_expense_categories', 'commission_categories', 'account', 'devices'
      ];
    }

    match /users/{uid}/{subcollection}/{docId} {
      allow list: if isValidId(uid)
        && allowedWorkspaceSub(subcollection)
        && inWorkspace(uid)
        && (isAdmin() || subcollection != 'settings');

      allow get: if isValidId(uid) && isValidId(docId)
        && allowedWorkspaceSub(subcollection)
        && (
          (inWorkspace(uid) && (isAdmin() || !(subcollection == 'settings' && docId == 'accounts')))
          || (subcollection in ['devices', 'settings'] && isAdmin() && managedByMe(targetUser(uid), uid))
        );

      allow write: if isValidId(uid) && isValidId(docId)
        && allowedWorkspaceSub(subcollection)
        && (
          (inWorkspace(uid) && isAdmin())
          || (subcollection in ['devices', 'settings'] && isAdmin() && managedByMe(targetUser(uid), uid))
        );
    }

    match /users/{uid}/{subcollection}/{docId}/{rest=**} {
      allow list: if isValidId(uid)
        && allowedWorkspaceSub(subcollection)
        && inWorkspace(uid)
        && (isAdmin() || subcollection != 'settings');

      allow get: if isValidId(uid) && isValidId(docId)
        && allowedWorkspaceSub(subcollection)
        && (
          (inWorkspace(uid) && (isAdmin() || !(subcollection == 'settings' && docId == 'accounts')))
          || (subcollection in ['devices', 'settings'] && isAdmin() && managedByMe(targetUser(uid), uid))
        );

      allow write: if isValidId(uid) && isValidId(docId)
        && allowedWorkspaceSub(subcollection)
        && (
          (inWorkspace(uid) && isAdmin())
          || (subcollection in ['devices', 'settings'] && isAdmin() && managedByMe(targetUser(uid), uid))
        );
    }
  }
}
