rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Hardened Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNum(val) {
      return (val is int || val is float);
    }

    function isBoundedStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidTs(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidMemberUids(list, ownerId) {
      return list is list &&
             list.size() >= 1 &&
             list.size() <= 20 &&
             list[0] is string &&
             list[0].size() <= 128 &&
             ownerId in list;
    }

    function isValidStringList(list, maxLen) {
      return list is list &&
             list.size() <= maxLen &&
             (list.size() == 0 || (list[0] is string && list[0].size() <= 80));
    }

    function isValidMapList(list, maxLen) {
      return list is list &&
             list.size() <= maxLen &&
             (list.size() == 0 || list[0] is map);
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isWorkspaceOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // Single-document parent gate for workspace membership & admin status
    function isActiveWorkspaceMember(ownerId) {
      return isWorkspaceOwner(ownerId) || (
        isSignedIn() &&
        exists(userDocPath(request.auth.uid)) &&
        get(userDocPath(request.auth.uid)).data.workspaceOwnerUid == ownerId &&
        get(userDocPath(request.auth.uid)).data.approved == true
      );
    }

    function isWorkspaceAdmin(ownerId) {
      return isWorkspaceOwner(ownerId) || (
        isActiveWorkspaceMember(ownerId) &&
        get(userDocPath(request.auth.uid)).data.role == 'admin'
      );
    }

    // 3. Schema Validators (Anti-Update-Gap Blueprints)

    function isValidUserProfile(data, userId) {
      return data.uid is string && data.uid == userId &&
             isBoundedStr(data.email, 3, 160) &&
             isBoundedStr(data.displayName, 1, 80) &&
             isBoundedStr(data.workspaceOwnerUid, 1, 128) &&
             data.role in ['admin', 'member'] &&
             isValidStringList(data.roles, 8) &&
             data.approved is bool &&
             (!('inviteId' in data) || (data.inviteId is string && data.inviteId.size() <= 128)) &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidWorkspaceInvite(data) {
      return isBoundedStr(data.ownerUid, 1, 128) &&
             isBoundedStr(data.ownerName, 1, 80) &&
             isBoundedStr(data.memberEmail, 3, 160) &&
             isBoundedStr(data.displayName, 1, 80) &&
             isValidStringList(data.roles, 8) &&
             data.approved is bool &&
             data.status in ['pending', 'accepted', 'revoked'] &&
             (!('acceptedByUid' in data) || isBoundedStr(data.acceptedByUid, 1, 128)) &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidStoreConfig(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.storeKey, 1, 64) &&
             isBoundedStr(data.name, 1, 80) &&
             isBoundedStr(data.formulaId, 0, 128) &&
             isNum(data.salePrice) && data.salePrice >= 0 && data.salePrice <= 100000000 &&
             data.active is bool &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidFormulaConfig(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.name, 1, 80) &&
             isNum(data.unitsPerBatch) && data.unitsPerBatch > 0 && data.unitsPerBatch <= 1000000 &&
             isNum(data.additionalCost) && data.additionalCost >= 0 && data.additionalCost <= 100000000 &&
             isNum(data.costAdjustment) && data.costAdjustment >= -100000000 && data.costAdjustment <= 100000000 &&
             isValidMapList(data.ingredients, 40) &&
             isValidMapList(data.savedMixes, 40) &&
             isValidMapList(data.savedCorrections, 40) &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidCustomerRecord(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.name, 1, 80) &&
             isBoundedStr(data.phone, 0, 32) &&
             isBoundedStr(data.address, 0, 200) &&
             (!('routeLat' in data) || isNum(data.routeLat)) &&
             (!('routeLng' in data) || isNum(data.routeLng)) &&
             data.visitCount is int && data.visitCount >= 0 && data.visitCount <= 1000000 &&
             isNum(data.openingBalance) && data.openingBalance >= -100000000 && data.openingBalance <= 100000000 &&
             (!('notes' in data) || isBoundedStr(data.notes, 0, 500)) &&
             data.recycled is bool &&
             data.recycledAtEpoch is int && data.recycledAtEpoch >= 0 &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidEntityRecord(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.name, 1, 80) &&
             data.entityType in ['party', 'supplier', 'staff', 'expense', 'bank'] &&
             isBoundedStr(data.phone, 0, 32) &&
             (!('notes' in data) || isBoundedStr(data.notes, 0, 500)) &&
             isNum(data.openingBalance) && data.openingBalance >= -100000000 && data.openingBalance <= 100000000 &&
             data.recycled is bool &&
             data.recycledAtEpoch is int && data.recycledAtEpoch >= 0 &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidInventoryItem(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.name, 1, 80) &&
             isBoundedStr(data.unitName, 1, 32) &&
             isNum(data.conversionFactor) && data.conversionFactor > 0 && data.conversionFactor <= 100000 &&
             isNum(data.stockQty) && data.stockQty >= -10000000 && data.stockQty <= 10000000 &&
             isNum(data.avgCostPerKg) && data.avgCostPerKg >= 0 && data.avgCostPerKg <= 100000000 &&
             isNum(data.minThreshold) && data.minThreshold >= 0 && data.minThreshold <= 10000000 &&
             (!('supplierName' in data) || isBoundedStr(data.supplierName, 0, 80)) &&
             data.recycled is bool &&
             data.recycledAtEpoch is int && data.recycledAtEpoch >= 0 &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidProductionRecord(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.date, 8, 20) &&
             isBoundedStr(data.storeKey, 1, 64) &&
             isBoundedStr(data.storeName, 1, 80) &&
             (!('formulaId' in data) || isBoundedStr(data.formulaId, 0, 128)) &&
             isNum(data.formulaUnits) && data.formulaUnits >= 0 && data.formulaUnits <= 1000000 &&
             isNum(data.grossWeight) && data.grossWeight >= 0 && data.grossWeight <= 1000000 &&
             isNum(data.containerWeight) && data.containerWeight >= 0 && data.containerWeight <= 1000000 &&
             isNum(data.netWeight) && data.netWeight >= -1000000 && data.netWeight <= 1000000 &&
             isNum(data.costPerKg) && data.costPerKg >= 0 && data.costPerKg <= 100000000 &&
             isNum(data.salePrice) && data.salePrice >= 0 && data.salePrice <= 100000000 &&
             isNum(data.totalCost) && data.totalCost >= -1000000000 && data.totalCost <= 1000000000 &&
             isNum(data.totalRevenue) && data.totalRevenue >= -1000000000 && data.totalRevenue <= 1000000000 &&
             isNum(data.profit) &&
             data.transfer is bool &&
             data.transferType in ['none', 'out', 'in'] &&
             (!('transferPairId' in data) || isBoundedStr(data.transferPairId, 0, 128)) &&
             (!('transferPeerStore' in data) || isBoundedStr(data.transferPeerStore, 0, 80)) &&
             (!('notes' in data) || isBoundedStr(data.notes, 0, 500)) &&
             data.recycled is bool &&
             data.recycledAtEpoch is int && data.recycledAtEpoch >= 0 &&
             isBoundedStr(data.createdByUid, 1, 128) &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidSalesRecord(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.date, 8, 20) &&
             data.mode in ['sale', 'collection'] &&
             (!('customerId' in data) || isBoundedStr(data.customerId, 0, 128)) &&
             isBoundedStr(data.customerName, 1, 80) &&
             isBoundedStr(data.storeKey, 0, 64) &&
             (!('storeName' in data) || isBoundedStr(data.storeName, 0, 80)) &&
             isBoundedStr(data.repName, 1, 80) &&
             isNum(data.qtyKg) && data.qtyKg >= 0 && data.qtyKg <= 1000000 &&
             isNum(data.ratePerKg) && data.ratePerKg >= 0 && data.ratePerKg <= 100000000 &&
             isNum(data.totalAmount) && data.totalAmount >= 0 && data.totalAmount <= 1000000000 &&
             isNum(data.cashReceived) && data.cashReceived >= 0 && data.cashReceived <= 1000000000 &&
             isNum(data.creditAmount) && data.creditAmount >= 0 && data.creditAmount <= 1000000000 &&
             isNum(data.expiredKg) && data.expiredKg >= 0 && data.expiredKg <= 1000000 &&
             isNum(data.choraValue) && data.choraValue >= 0 && data.choraValue <= 1000000000 &&
             data.addToLedger is bool &&
             (!('ledgerEntryId' in data) || isBoundedStr(data.ledgerEntryId, 0, 128)) &&
             (!('notes' in data) || isBoundedStr(data.notes, 0, 500)) &&
             data.recycled is bool &&
             data.recycledAtEpoch is int && data.recycledAtEpoch >= 0 &&
             isBoundedStr(data.createdByUid, 1, 128) &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidRepRecord(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.date, 8, 20) &&
             isBoundedStr(data.repName, 1, 80) &&
             data.mode in ['sale', 'collection', 'return'] &&
             (!('customerId' in data) || isBoundedStr(data.customerId, 0, 128)) &&
             isBoundedStr(data.customerName, 1, 80) &&
             isBoundedStr(data.storeKey, 0, 64) &&
             isNum(data.qtyKg) && data.qtyKg >= 0 && data.qtyKg <= 1000000 &&
             isNum(data.ratePerKg) && data.ratePerKg >= 0 && data.ratePerKg <= 100000000 &&
             isNum(data.totalAmount) && data.totalAmount >= 0 && data.totalAmount <= 1000000000 &&
             isNum(data.cashReceived) && data.cashReceived >= 0 && data.cashReceived <= 1000000000 &&
             isNum(data.creditAmount) && data.creditAmount >= 0 && data.creditAmount <= 1000000000 &&
             (!('routeLat' in data) || isNum(data.routeLat)) &&
             (!('routeLng' in data) || isNum(data.routeLng)) &&
             data.addressConfirmed is bool &&
             (!('notes' in data) || isBoundedStr(data.notes, 0, 500)) &&
             data.recycled is bool &&
             data.recycledAtEpoch is int && data.recycledAtEpoch >= 0 &&
             isBoundedStr(data.createdByUid, 1, 128) &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidCalculatorSettlement(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.dateFrom, 8, 20) &&
             isBoundedStr(data.dateTo, 8, 20) &&
             isBoundedStr(data.repName, 1, 80) &&
             isBoundedStr(data.storeKey, 1, 64) &&
             isNum(data.totalSoldKg) && data.totalSoldKg >= 0 && data.totalSoldKg <= 1000000 &&
             isNum(data.returnedKg) && data.returnedKg >= 0 && data.returnedKg <= 1000000 &&
             data.returnTarget in ['store', 'rep'] &&
             (!('returnTargetName' in data) || isBoundedStr(data.returnTargetName, 0, 80)) &&
             isNum(data.expiredKg) && data.expiredKg >= 0 && data.expiredKg <= 1000000 &&
             isNum(data.sharedDeduction) && data.sharedDeduction >= 0 && data.sharedDeduction <= 1000000000 &&
             isNum(data.netSoldKg) &&
             isNum(data.cashQtyKg) && isNum(data.creditQtyKg) &&
             isNum(data.ratePerKg) && data.ratePerKg >= 0 && data.ratePerKg <= 100000000 &&
             isNum(data.commissionTotal) &&
             isValidMapList(data.commissions, 25) &&
             isNum(data.expenseTotal) &&
             isValidMapList(data.expenses, 40) &&
             isNum(data.expectedCash) && isNum(data.physicalCash) && isNum(data.variance) &&
             data.addToLedger is bool &&
             (!('ledgerEntryId' in data) || isBoundedStr(data.ledgerEntryId, 0, 128)) &&
             (!('notes' in data) || isBoundedStr(data.notes, 0, 500)) &&
             data.recycled is bool &&
             data.recycledAtEpoch is int && data.recycledAtEpoch >= 0 &&
             isBoundedStr(data.createdByUid, 1, 128) &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidFactoryRecord(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.date, 8, 20) &&
             data.recordType in ['batch', 'purchase'] &&
             (!('formulaId' in data) || isBoundedStr(data.formulaId, 0, 128)) &&
             (!('formulaName' in data) || isBoundedStr(data.formulaName, 0, 80)) &&
             (!('storeKey' in data) || isBoundedStr(data.storeKey, 0, 64)) &&
             data.unitsProduced is int && data.unitsProduced >= 0 && data.unitsProduced <= 1000000 &&
             (!('rawItemId' in data) || isBoundedStr(data.rawItemId, 0, 128)) &&
             (!('rawItemName' in data) || isBoundedStr(data.rawItemName, 0, 80)) &&
             (!('supplierName' in data) || isBoundedStr(data.supplierName, 0, 80)) &&
             isNum(data.qtyRawUnit) && data.qtyRawUnit >= 0 &&
             isNum(data.conversionFactor) && data.conversionFactor > 0 &&
             isNum(data.qtyKg) && data.qtyKg >= 0 &&
             isNum(data.unitCost) && data.unitCost >= 0 &&
             isNum(data.totalCost) && data.totalCost >= 0 &&
             isNum(data.paidAmount) && data.paidAmount >= 0 &&
             isNum(data.payableBalance) && data.payableBalance >= 0 &&
             isNum(data.allocatedPaid) && data.allocatedPaid >= 0 &&
             data.settled is bool &&
             isValidMapList(data.ingredientsUsed, 40) &&
             (!('notes' in data) || isBoundedStr(data.notes, 0, 500)) &&
             data.recycled is bool &&
             data.recycledAtEpoch is int && data.recycledAtEpoch >= 0 &&
             isBoundedStr(data.createdByUid, 1, 128) &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidPaymentTransaction(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.date, 8, 20) &&
             data.txType in ['in', 'out', 'expense', 'transfer_out', 'transfer_in'] &&
             (!('entityId' in data) || isBoundedStr(data.entityId, 0, 128)) &&
             isBoundedStr(data.entityName, 1, 80) &&
             isBoundedStr(data.entityCategory, 1, 40) &&
             isBoundedStr(data.paymentChannel, 1, 40) &&
             isNum(data.amount) && data.amount >= 0 && data.amount <= 1000000000 &&
             (!('transferPairId' in data) || isBoundedStr(data.transferPairId, 0, 128)) &&
             (!('peerEntityName' in data) || isBoundedStr(data.peerEntityName, 0, 80)) &&
             data.addToLedger is bool &&
             (!('ledgerEntryId' in data) || isBoundedStr(data.ledgerEntryId, 0, 128)) &&
             (!('notes' in data) || isBoundedStr(data.notes, 0, 500)) &&
             data.recycled is bool &&
             data.recycledAtEpoch is int && data.recycledAtEpoch >= 0 &&
             isBoundedStr(data.createdByUid, 1, 128) &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidDailyLedgerEntry(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.date, 8, 20) &&
             data.entryType in ['IN', 'OUT', 'TRANSFER'] &&
             data.expenseScope in ['business', 'home', 'none'] &&
             isBoundedStr(data.channel, 1, 40) &&
             (!('toChannel' in data) || isBoundedStr(data.toChannel, 0, 40)) &&
             isBoundedStr(data.category, 1, 60) &&
             isBoundedStr(data.partyName, 0, 80) &&
             isNum(data.amount) && data.amount > 0 && data.amount <= 1000000000 &&
             data.tabEntry is bool &&
             (!('sourceCollection' in data) || isBoundedStr(data.sourceCollection, 0, 40)) &&
             (!('sourceDocId' in data) || isBoundedStr(data.sourceDocId, 0, 128)) &&
             (!('notes' in data) || isBoundedStr(data.notes, 0, 500)) &&
             data.recycled is bool &&
             data.recycledAtEpoch is int && data.recycledAtEpoch >= 0 &&
             isBoundedStr(data.createdByUid, 1, 128) &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidPendingApproval(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.submittedByUid, 1, 128) &&
             isBoundedStr(data.submittedByName, 1, 80) &&
             isBoundedStr(data.submittedByEmail, 3, 160) &&
             data.action in ['set', 'delete'] &&
             data.targetCollection in [
               'production', 'sales', 'rep_records', 'calculator',
               'factory', 'transactions', 'ledger_entries', 'inventory',
               'customers', 'entities'
             ] &&
             isBoundedStr(data.targetDocId, 1, 128) &&
             isBoundedStr(data.summaryTitle, 1, 120) &&
             isBoundedStr(data.summaryDetail, 0, 500) &&
             isBoundedStr(data.recordDate, 0, 20) &&
             data.payloadData is map && data.payloadData.size() <= 40 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             (!('reviewedByUid' in data) || isBoundedStr(data.reviewedByUid, 0, 128)) &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    function isValidWorkspaceSettings(data, ownerId) {
      return data.ownerUid == ownerId &&
             isValidMemberUids(data.memberUids, ownerId) &&
             isBoundedStr(data.currencySymbol, 1, 12) &&
             data.financialYearStartMonth is int && data.financialYearStartMonth >= 1 && data.financialYearStartMonth <= 12 &&
             data.hideSensitiveMoney is bool &&
             data.biometricLockEnabled is bool &&
             data.themeMode in ['dark', 'light', 'system'] &&
             isValidStringList(data.paymentChannels, 15) &&
             isValidStringList(data.expenseCategories, 30) &&
             isValidTs(data.createdAt) &&
             isValidTs(data.updatedAt);
    }

    // 4. Collection Rules

    match /users/{userId} {
      allow list: if isSignedIn() && (
        request.auth.uid == userId ||
        resource.data.workspaceOwnerUid == request.auth.uid
      );
      allow get: if isValidId(userId) && isSignedIn() && (
        request.auth.uid == userId ||
        resource.data.workspaceOwnerUid == request.auth.uid
      );

      allow create: if isValidId(userId) &&
        isSignedIn() &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming(), userId) &&
        incoming().keys().hasAll(['uid', 'email', 'displayName', 'workspaceOwnerUid', 'role', 'roles', 'approved', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['uid', 'email', 'displayName', 'workspaceOwnerUid', 'role', 'roles', 'approved', 'inviteId', 'createdAt', 'updatedAt']) &&
        (
          (incoming().workspaceOwnerUid == request.auth.uid && incoming().role == 'admin' && incoming().approved == true) ||
          (
            'inviteId' in incoming() &&
            isValidId(incoming().inviteId) &&
            exists(/databases/$(database)/documents/workspace_invites/$(incoming().inviteId)) &&
            get(/databases/$(database)/documents/workspace_invites/$(incoming().inviteId)).data.ownerUid == incoming().workspaceOwnerUid &&
            get(/databases/$(database)/documents/workspace_invites/$(incoming().inviteId)).data.status == 'pending' &&
            get(/databases/$(database)/documents/workspace_invites/$(incoming().inviteId)).data.approved == true &&
            request.auth.token.email_verified == true &&
            get(/databases/$(database)/documents/workspace_invites/$(incoming().inviteId)).data.memberEmail == request.auth.token.email.lower() &&
            incoming().role == 'member'
          )
        );

      allow update: if isValidId(userId) &&
        isSignedIn() &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        (
          // User updating own harmless displayName/updatedAt
          (
            request.auth.uid == userId &&
            incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
            incoming().role == existing().role &&
            incoming().roles == existing().roles &&
            incoming().approved == existing().approved &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          ) ||
          // Workspace owner updating a team member's roles / approval
          (
            userId != request.auth.uid &&
            existing().workspaceOwnerUid == request.auth.uid &&
            incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'roles', 'approved', 'displayName', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) &&
        isSignedIn() &&
        userId != request.auth.uid &&
        existing().workspaceOwnerUid == request.auth.uid;
    }

    match /workspace_invites/{inviteId} {
      allow list: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (request.auth.token.email_verified == true && resource.data.memberEmail == request.auth.token.email.lower())
      );
      allow get: if isValidId(inviteId) && isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (request.auth.token.email_verified == true && resource.data.memberEmail == request.auth.token.email.lower())
      );

      allow create: if isValidId(inviteId) &&
        isSignedIn() &&
        incoming().ownerUid == request.auth.uid &&
        isValidWorkspaceInvite(incoming()) &&
        incoming().keys().hasAll(['ownerUid', 'ownerName', 'memberEmail', 'displayName', 'roles', 'approved', 'status', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['ownerUid', 'ownerName', 'memberEmail', 'displayName', 'roles', 'approved', 'status', 'acceptedByUid', 'createdAt', 'updatedAt']);

      allow update: if isValidId(inviteId) &&
        isSignedIn() &&
        isValidWorkspaceInvite(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        (
          // Workspace owner updates invite roles/status
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'roles', 'approved', 'status', 'updatedAt'])
          ) ||
          // Invited member accepts pending invite with verified email
          (
            existing().status == 'pending' &&
            request.auth.token.email_verified == true &&
            existing().memberEmail == request.auth.token.email.lower() &&
            incoming().status == 'accepted' &&
            incoming().acceptedByUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'updatedAt'])
          )
        );

      allow delete: if isValidId(inviteId) &&
        isSignedIn() &&
        existing().ownerUid == request.auth.uid;
    }

    // Standard workspace subcollections (Admin writes directly; owner/members list via memberUids without get())

    match /users/{ownerId}/stores/{storeId} {
      allow list: if isSignedIn() && (request.auth.uid == ownerId || request.auth.uid in resource.data.memberUids);
